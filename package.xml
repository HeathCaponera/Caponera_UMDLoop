<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waypoint_field_nav</name>
  <version>1.0.0</version>
  <description>
    Autonomous waypoint navigation for a differential-drive vehicle in
    Gazebo (ROS 2 Jazzy + Gazebo Harmonic). A potential-field controller with
    a weighted-Dijkstra/A* fallback drives a box robot through a sequence of
    randomized waypoints while avoiding randomly generated obstacles. Includes
    a course generator that emits matching Gazebo worlds and course manifests.
  </description>
  <maintainer email="dev@example.com">Robotics Challenge</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Simulation + bridge stack (Jazzy pairs with Gazebo Harmonic) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
